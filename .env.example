# Copy to .env and adjust. Never commit .env.
# Kadi refuses to start while the placeholder values below (change-me, example.edu) remain.

KADI_VERSION=1.12.0

# Public hostname users reach Kadi under, as your reverse proxy serves it over HTTPS. Must
# match the Host header exactly, so include the port if it is not 443.
KADI_SERVER_NAME=kadi4mat.example.edu

# Optional bundled services, comma separated:
#   postgres - run PostgreSQL inside this stack (remove to use an existing server below)
#   caddy    - bundled HTTPS reverse proxy, only if the host has no reverse proxy yet
COMPOSE_PROFILES=postgres

# Optional override files, colon separated, always starting with docker-compose.yml:
#   compose.bind-mounts.yml       - data in host directories under KADI_DATA_DIR
#   compose.external-network.yml  - join an existing Docker network (EXTERNAL_NETWORK)
#   compose.db-network.yml        - join the database's network if it differs (DB_NETWORK)
# Example: COMPOSE_FILE=docker-compose.yml:compose.bind-mounts.yml:compose.external-network.yml
# COMPOSE_FILE=docker-compose.yml

# --- Data location ---------------------------------------------------------------------
# Default: named Docker volumes. With compose.bind-mounts.yml, all data lives here instead;
# ownership of the subdirectories is fixed automatically on every start.
# KADI_DATA_DIR=/data/kadi

# --- Reverse proxy ---------------------------------------------------------------------
# Your proxy terminates TLS and forwards plain HTTP to Kadi. See README.md.
# Proxy running directly on the host: it connects to this address.
KADI_HTTP_BIND=127.0.0.1:8000
# Proxy running as a container: add compose.external-network.yml to COMPOSE_FILE and
# proxy to kadi4mat-kadi:8000.
# EXTERNAL_NETWORK=proxy

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
KADI_SECRET_KEY=change-me

# --- Database --------------------------------------------------------------------------
# With the "postgres" profile, keep POSTGRES_HOST=postgres; the values below create the
# bundled database. For an existing server see README.md; POSTGRES_HOST is then:
#   host.docker.internal  for a server running directly on the Docker host
#   <container name>      for a PostgreSQL container on EXTERNAL_NETWORK or DB_NETWORK
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kadi
POSTGRES_DB=kadi
POSTGRES_PASSWORD=change-me
# disable, prefer, require, verify-full, ...
POSTGRES_SSLMODE=prefer
# Only with compose.db-network.yml, if the database is not on EXTERNAL_NETWORK. Must differ
# from EXTERNAL_NETWORK.
# DB_NETWORK=postgres

KADI_ALLOW_REGISTRATION=false
KADI_EMAIL_CONFIRMATION_REQUIRED=false

# "localhost" is the container itself, so point this at a real mail server. Kadi logs a
# warning on startup while it is left at localhost.
KADI_SMTP_HOST=localhost
KADI_SMTP_PORT=25
KADI_SMTP_USERNAME=
KADI_SMTP_PASSWORD=
KADI_SMTP_USE_TLS=true
# KADI_MAIL_NO_REPLY=no-reply@kadi4mat.example.edu

UWSGI_PROCESSES=4
# Threads per worker that stream file downloads and static files.
UWSGI_OFFLOAD_THREADS=2

# Elasticsearch 8.x image tag. Kadi 1.12 uses the 8.18 Python client, which supports all
# later 8.x servers; Elasticsearch 9 is not supported.
ELASTICSEARCH_VERSION=8.19.21
ES_JAVA_OPTS=-Xms1g -Xmx1g
